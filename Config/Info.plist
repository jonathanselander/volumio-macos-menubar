<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Menu bar only: no Dock icon, no app menu. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Shown in the "allow local network access" prompt (macOS 15+). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>VolumioBar finds and controls the Volumio players on your network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_Volumio._tcp</string>
	</array>
	<!-- Volumio's API is plain HTTP on your LAN. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
